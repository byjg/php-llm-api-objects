{
    "name": "byjg/llm-api-objects",
    "description": "Strongly-typed PHP objects for LLM API request payloads",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "ByJG\\LlmApiObjects\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ByJG\\LlmApiObjects\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3 <8.7",
        "byjg/anydataset-xml": "^7.0"
    },
    "require-dev": {
        "openai-php/client": "^v0.19",

        "phpunit/phpunit": "^12.5"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "psalm": [
      "@composer --working-dir=tools/psalm update --no-interaction",
      "tools/psalm/vendor/bin/psalm"
    ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
